# Application Configuration
PORT=3000
NODE_ENV=production

# CORS Configuration (Comma-separated allowed origins in production, e.g. https://app.healthcare.com)
CORS_ORIGIN="https://your-frontend-domain.com"

# Database Connection (Supabase PostgreSQL Connection String)
# Obtain from Supabase Dashboard -> Project Settings -> Database
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?schema=public"

# Integration/E2E Test Database Connection (Dedicated Test DB - NEVER production database!)
TEST_DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?schema=public"

# Supabase Auth Configuration
# Obtain from Supabase Dashboard -> Project Settings -> API -> JWT Settings
SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"
SUPABASE_JWT_SECRET="your-super-secret-jwt-token-with-at-least-32-characters-long"
SUPABASE_JWT_ISSUER="https://[YOUR_PROJECT_REF].supabase.co/auth/v1"
SUPABASE_JWT_AUDIENCE="authenticated"

# Storage Configuration (Supabase Storage)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="medical-documents"
